@import "../../utils/merchant.wxss";
.category-number{width:74rpx;height:78rpx;display:flex;align-items:center;justify-content:center;background:#f7e7df;color:#b84c32;font-size:31rpx;border-radius:14rpx;font-weight:600;flex-shrink:0}.category-number.is-off{background:#efebe5;color:#ab9e8f}.category-info{flex:1;min-width:0;margin:0 18rpx}.category-title{font-size:29rpx;font-weight:600;word-break:break-all}.category-count{width:auto;margin:0;font-size:21rpx;color:#a28e7a;padding-top:10rpx;text-align:left}.category-tip{font-size:20rpx;color:#a18f7d;margin-top:20rpx;background:#f5f1ea;padding:12rpx 16rpx;border-radius:8rpx}.category-actions{border-top:1rpx solid #f0e8dd;margin-top:22rpx;padding-top:16rpx;gap:12rpx}.category-actions>button{width:auto;font-size:23rpx;padding:10rpx 20rpx;border-radius:8rpx;background:#f5f1eb;color:#766654}.sort-actions{gap:8rpx;margin-right:auto}.sort-actions button{border:1rpx solid #eee6dc;border-radius:8rpx;width:50rpx;height:50rpx;line-height:46rpx;font-size:26rpx;color:#9b8a77}.category-actions .accent-action{color:#b84c32;background:#fbede6}.category-actions .delete-action{background:transparent;color:#a38476}.name-counter{font-size:20rpx;color:#b4a797;text-align:right;margin:12rpx 0 28rpx}

.sheet .primary{width:100%}
