<block wx:if="{{authorized}}"><view class="merchant-hero"><view class="hero-kicker">炭火里 · 菜单经营</view><view class="row between"><view class="hero-title">分区管理</view><view class="hero-symbol">区</view></view><view class="hero-description">好菜单，从井井有条开始。</view><view class="hero-bottom">分区顺序与上下架状态将同步到顾客菜单</view></view>
<view class="merchant-body has-bottom"><view class="demo-label">{{simulatorPreview ? '开发工具本地演示 · 未验证商家身份' : '云端数据 · 多设备同步'}}</view><view class="metric-card"><view><text class="metric-value">{{totalCount}}</text><text class="metric-label">全部分区</text></view><view><text class="metric-value">{{activeCount}}</text><text class="metric-label">已上架</text></view><view><text class="metric-value muted">{{offCount}}</text><text class="metric-label">已下架</text></view></view>
<view class="segmented"><button class="{{filter === 'all' ? 'selected' : ''}}" data-id="all" bindtap="filter">全部分区</button><button class="{{filter === 'on' ? 'selected' : ''}}" data-id="on" bindtap="filter">已上架</button><button class="{{filter === 'off' ? 'selected' : ''}}" data-id="off" bindtap="filter">已下架</button></view><view class="list-heading row between"><text class="workspace-heading">菜单分区</text><text class="small muted">{{categories.length}} 个分区</text></view>
<view wx:for="{{categories}}" wx:key="id" class="merchant-card category-card"><view class="row"><view class="category-number {{item.onSale === false ? 'is-off' : ''}}">{{item.positionText}}</view><view class="category-info"><view class="category-title">{{item.name}}</view><button class="category-count" data-id="{{item.id}}" bindtap="dishes">{{item.count}} 款菜品 · 管理菜品 ›</button></view><text class="status-badge {{item.onSale === false ? 'off' : ''}}">{{item.onSale === false ? '已下架' : '已上架'}}</text></view><view wx:if="{{item.onSale === false}}" class="category-tip">顾客菜单已隐藏此分区及区内菜品</view><view class="category-actions row"><view class="sort-actions row"><button disabled="{{item.first}}" data-id="{{item.id}}" data-direction="-1" bindtap="move">↑</button><button disabled="{{item.last}}" data-id="{{item.id}}" data-direction="1" bindtap="move">↓</button></view><button data-id="{{item.id}}" bindtap="status">{{item.onSale === false ? '上架' : '下架'}}</button><button class="accent-action" data-id="{{item.id}}" bindtap="editCategory">编辑</button><button class="delete-action" data-id="{{item.id}}" bindtap="deleteCategory">删除</button></view></view>
<view wx:if="{{!categories.length}}" class="merchant-card empty"><view class="empty-mark">▦</view><view class="empty-title">{{totalCount ? '暂无此状态的分区' : '为好味划个分区'}}</view><view class="empty-copy">{{totalCount ? '切换筛选查看其他分区。' : '肉类、素类、饮料，让顾客更快找到喜欢的菜。'}}</view></view><view class="merchant-foot">分区下架保留菜品，空分区可删除。</view></view><view class="bottom-bar"><button class="primary" bindtap="addCategory">＋ 新增分区</button></view>
<view wx:if="{{editorOpen}}" class="overlay" bindtap="closeEditor"><view class="sheet" catchtap="noop"><view class="row between"><text class="section-title">{{editingId ? '编辑分区' : '新增分区'}}</text><button class="close" bindtap="closeEditor">×</button></view><view class="subtitle">清晰的分区名称，让点单更轻松。</view><view class="field-label">分区名称</view><input class="input" maxlength="12" placeholder="例如：招牌烧烤" value="{{categoryName}}" bindinput="categoryName"/><view class="name-counter">{{categoryName.length}} / 12</view><button class="primary" bindtap="saveCategory">{{editingId ? '保存修改' : '创建分区'}}</button></view></view></block>
