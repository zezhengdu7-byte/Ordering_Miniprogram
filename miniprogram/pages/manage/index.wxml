<block wx:if="{{authorized}}">
<view class="dashboard">
  <view class="dashboard-hero">
    <view class="row between"><view><view class="hero-kicker">{{dateText}} · 门店运营</view><view class="hero-title">小店工作台</view><view class="hero-description">{{shopName}}</view></view><view class="ticket-art"><view class="ticket-square"/><view class="ticket-line"/><view class="ticket-line short"/><view class="ticket-bottom">ORDER / 炭</view></view></view>
    <view class="row between hero-bottom"><text class="business-status">● {{open ? '营业中' : '休息中'}}</text><button class="customer-button" bindtap="preview">顾客视角 ↗</button></view>
  </view>
  <view class="dashboard-body">
    <view class="demo-label">{{simulatorPreview ? '开发工具本地演示 · 未验证商家身份' : '云端数据 · 多设备同步'}}</view>
    <view class="summary-card"><view class="row between"><text class="summary-title">今日概览</text><text class="summary-date">云端数据</text></view><view class="summary-grid"><view><view class="summary-value">{{todayCount}}<text class="summary-unit"> 单</text></view><text class="summary-caption">今日有效订单</text></view><view><view class="summary-value">{{paidText}}</view><text class="summary-caption">模拟收款 / 元</text></view></view><view class="todo-row"><button class="todo-button" data-page="pending" bindtap="go"><text class="todo-dot"/>待接单 <text class="todo-number">{{pendingCount}}</text><text class="todo-arrow">›</text></button><button class="todo-button" data-page="making" bindtap="go"><text class="todo-dot amber"/>制作中 <text class="todo-number">{{makingCount}}</text><text class="todo-arrow">›</text></button></view></view>
    <view class="workspace-card"><view class="workspace-heading">经营管理</view><view class="workspace-grid">
      <button class="workspace-item" data-page="dishes" bindtap="go"><view class="menu-icon brick icon-dish"><view class="icon-roof"/><view class="icon-door"/></view><view class="item-title">菜品管理</view><view class="item-caption">{{dishCount}} 款菜品</view></button>
      <button class="workspace-item" data-page="categories" bindtap="go"><view class="menu-icon blue icon-category"><view/><view/><view/><view/></view><view class="item-title">分区管理</view><view class="item-caption">{{categoryCount}} 个菜单分区</view></button>
      <button class="workspace-item" data-page="orders" bindtap="go"><view class="menu-icon green icon-orders"><view/><view/><view/></view><view class="item-title">订单管理</view><view class="item-caption">接单 · 制作 · 出餐</view></button>
    </view></view>
    <view class="workspace-card"><view class="workspace-heading">门店设置</view><view class="workspace-grid">
      <button class="workspace-item" data-page="shop" bindtap="go"><view class="menu-icon brick icon-settings">⚙</view><view class="item-title">店铺设置</view><view class="item-caption">店名与营业状态</view></button>
      <button class="workspace-item" data-page="tables" bindtap="go"><view class="menu-icon teal icon-table"><view/><view/><view/><view/></view><view class="item-title">桌台与桌码</view><view class="item-caption">{{tableCount}} 张桌台</view></button>
      <button class="workspace-item" data-page="printer" bindtap="go"><view class="menu-icon amber-text icon-printer"><view class="printer-paper"/><view class="printer-body"/><view class="printer-output"/></view><view class="item-title">打印机管理</view><view class="item-caption">设备设置 · 小票预览</view></button>
    </view></view>
    <view class="dashboard-foot">好好经营，每一桌烟火。</view>
  </view>
</view>
</block>

<view wx:else class="auth-loading"><view class="section-title">正在验证门店管理身份</view><view class="subtitle">验证通过后显示工作台，请稍候。</view><button class="primary" bindtap="retryAuth">重新验证</button></view>
