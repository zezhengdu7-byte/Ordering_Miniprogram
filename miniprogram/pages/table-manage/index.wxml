<block wx:if="{{authorized}}">
<view class="merchant-hero">
  <view class="hero-kicker">炭火里 · 桌台经营</view>
  <view class="row between"><view class="hero-title">桌台管理</view><view class="hero-symbol">桌</view></view>
  <view class="hero-description">每一桌的订单与消费，一眼看清。</view>
  <view class="hero-bottom row between"><text>{{occupiedCount}} 桌用餐中</text><button bindtap="qr">桌码管理 ↗</button></view>
</view>
<view class="merchant-body">
  <view class="demo-label">{{simulatorPreview ? '开发工具本地演示 · 未验证商家身份' : '云端数据 · 自动汇总本桌订单'}}</view>
  <view class="metric-card">
    <view><text class="metric-value">{{occupiedCount}}</text><text class="metric-label">用餐中</text></view>
    <view><text class="metric-value">{{currentOrderCount}}</text><text class="metric-label">桌台累计订单</text></view>
    <view><text class="metric-value amber">¥{{currentTotalText}}</text><text class="metric-label">桌台累计消费</text></view>
  </view>
  <view wx:if="{{error}}" class="merchant-card table-error">{{error}}<button bindtap="refresh">重新加载</button></view>
  <view class="list-heading row between"><text class="workspace-heading">全部桌台</text><text class="small muted">{{totalCount}} 桌</text></view>
  <view wx:for="{{tables}}" wx:key="id" class="merchant-card table-card {{item.occupied ? 'busy' : ''}}">
    <view class="row between table-heading" data-id="{{item.id}}" bindtap="openTable">
      <view class="row table-name-row"><view class="table-avatar">{{item.name}}</view><view><view class="table-name">{{item.name}} 桌</view><view class="table-state">{{item.occupied ? '用餐中' : '空桌'}}</view></view></view>
      <view class="table-total"><text>累计消费</text><view>¥{{item.totalText}}</view></view>
    </view>
    <view class="table-metrics row">
      <text>{{item.orderCount}} 笔有效订单</text>
      <text wx:if="{{item.pendingCount}}" class="pending-text">{{item.pendingCount}} 笔待接单</text>
      <text wx:else class="muted">{{item.occupied ? '暂无待接单' : '等待顾客入座'}}</text>
    </view>
    <view class="table-actions row">
      <button data-id="{{item.id}}" bindtap="openTable">查看本桌订单</button>
      <button class="assist-action" data-id="{{item.id}}" bindtap="assist">代客下单</button>

    </view>

  </view>
  <view wx:if="{{!tables.length && !error}}" class="merchant-card empty"><view class="empty-title">还没有桌台</view><view class="empty-copy">请先在桌码管理中创建桌台。</view></view>
  <view class="merchant-foot">订单金额不包含已取消订单。</view>
</view>
</block>
