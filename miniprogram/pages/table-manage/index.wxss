@import "../../utils/merchant.wxss";
.table-actions .assist-action{background:#b84c32;color:#fff8ee}
.table-error{color:#a94f35;font-size:22rpx}.table-error button{display:block;margin-top:12rpx;color:#b84c32;font-size:22rpx}
.table-card{border-left:6rpx solid #e4ddd3}.table-card.busy{border-left-color:#b84c32}
.table-heading{align-items:flex-start}.table-name-row{gap:16rpx;min-width:0}.table-avatar{height:68rpx;min-width:68rpx;padding:0 12rpx;border-radius:12rpx;background:#f3eee7;color:#665646;font-weight:600;font-size:25rpx;display:flex;align-items:center;justify-content:center}.busy .table-avatar{background:#f9e9e1;color:#b84c32}.table-name{font-size:29rpx;font-weight:600}.table-state{font-size:20rpx;color:#a4917e;margin-top:8rpx}.busy .table-state{color:#b84c32}.table-total{text-align:right;flex-shrink:0;margin-left:18rpx}.table-total>text{font-size:18rpx;color:#aa9987}.table-total>view{font-size:31rpx;color:#b84c32;font-weight:600;margin-top:7rpx;font-variant-numeric:tabular-nums}.table-metrics{border-top:1rpx solid #f0e8dd;margin-top:21rpx;padding-top:18rpx;gap:20rpx;font-size:21rpx;color:#897967;flex-wrap:wrap}.pending-text{color:#b84c32}.table-actions{gap:12rpx;margin-top:18rpx}.table-actions button{width:auto;flex:0 0 auto;padding:12rpx 20rpx;border-radius:8rpx;background:#f5f1eb;color:#776653;font-size:21rpx}.table-actions button:last-child{color:#b84c32;background:#fbede6}.table-orders{border-top:1rpx dashed #e7ddd1;margin-top:20rpx;padding-top:4rpx}.table-empty{font-size:22rpx;color:#a3917f;padding:22rpx 0}.table-order{padding:20rpx 0;border-bottom:1rpx solid #f2eae0}.table-order:last-child{border-bottom:0;padding-bottom:0}.order-number{font-size:22rpx;color:#5a4b3d;font-weight:600;display:inline-block;max-width:360rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle}.source-tag{display:inline-block;margin-left:10rpx;padding:4rpx 8rpx;background:#edf2e9;color:#698363;border-radius:5rpx;font-size:17rpx;vertical-align:middle}.source-tag.assist{background:#faf0dc;color:#a7803c}.order-dishes{font-size:22rpx;color:#7f6e5d;line-height:1.7;margin-top:12rpx;word-break:break-all}.order-total{font-size:20rpx;color:#aa9989;margin-top:12rpx}.order-total text:last-child{font-size:24rpx;color:#665343;font-weight:600}
