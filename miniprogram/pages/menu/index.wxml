<view class="menu-page">
  <view class="store-header row between">
    <view><view class="eyebrow">CHARCOAL · GOOD TIMES</view><view class="brand" bindlongpress="staffLogin">{{shopName}}</view></view>
    <view class="store-actions"><button wx:if="{{merchantVisible}}" class="text-button" bindtap="toManage">门店管理 ↗</button><button class="table-label table-scan" bindtap="scanTable" loading="{{scanning || tablePending}}" disabled="{{scanning || tablePending}}" aria-label="扫码确认桌号"><text class="table-number">{{tableConfirmed || tablePending ? tableName : '扫码识别桌号 ↗'}}</text><text wx:if="{{tableConfirmed}}" class="scan-hint">重新扫码 ↗</text></button></view>
  </view>
  <view class="hero">
    <image src="/assets/menu/lamb.jpg" mode="aspectFill" class="hero-image"/>
    <view class="hero-shade"/>
    <view class="hero-copy"><view class="hero-kicker">好好吃饭，慢慢碰杯</view><view class="hero-title"><view>人间烟火，</view><view>刚好是你喜欢的。</view></view><view class="hero-tag">炭火现烤 / 下单即做</view></view>
  </view>
  <view wx:if="{{dining}}" class="notice">本桌 {{dining.people}} 人 · 餐具 {{dining.cutlery}} 套 · 餐巾纸 {{dining.napkins}} 份（费用随首笔订单计入一次）</view><view class="menu-info row between"><text>{{welcome}}</text><text class="muted">{{open ? '云端点单 · 无真实扣款' : '休息中 · 暂不接单'}}</text></view>
  <view class="menu-body">
    <scroll-view scroll-y class="category-rail"><view wx:for="{{categories}}" wx:key="id" class="category {{activeCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="category"><view>{{item.name}}</view><view class="category-count">{{item.count}} 款</view></view></scroll-view>
    <scroll-view scroll-y class="dish-list">
      <view class="list-heading row between"><text>现烤好味</text><text class="small muted">点图片可选辣度</text></view>
      <view wx:for="{{dishes}}" wx:key="id" class="dish-card {{item.soldOut ? 'sold' : ''}}">
        <view class="dish-photo" data-id="{{item.id}}" bindtap="choose"><image src="{{item.image}}" mode="aspectFill"/><view wx:if="{{item.soldOut}}" class="sold-mask">今日售罄</view></view>
        <view class="dish-content"><view class="dish-name">{{item.name}}</view><view class="dish-description">{{item.description}}</view><text wx:if="{{item.tag}}" class="dish-tag">{{item.tag}}</text><view class="dish-bottom row between"><view><text class="amount"><text class="currency">¥</text>{{item.priceText}}</text><text class="unit">/{{item.unit}}</text></view><view class="menu-stepper"><button wx:if="{{item.quantity}}" size="mini" class="quantity-button minus" data-id="{{item.id}}" data-delta="-1" bindtap="quickStep" aria-label="减少{{item.name}}">−</button><text wx:if="{{item.quantity}}" class="quantity-number">{{item.quantity}}</text><button size="mini" class="quantity-button plus" disabled="{{item.soldOut}}" data-id="{{item.id}}" data-delta="1" bindtap="quickStep" aria-label="增加{{item.name}}">+</button></view></view><view wx:if="{{item.quantity}}" class="chosen-count">已选 {{item.quantity}} {{item.unit}}</view></view>
      </view>
      <view wx:if="{{!dishes.length}}" class="empty"><view class="empty-title">这个分区还没有菜品</view><view class="empty-copy">可以去商家端添加几道好菜</view></view>
      <view class="list-end">食材用心 · 每一口都算数</view>
    </scroll-view>
  </view>
  <view class="cart-bar row between"><view class="cart-summary row" bindtap="toggleCart"><view class="bag-icon">▱<text wx:if="{{count}}" class="cart-badge">{{count}}</text></view><view><view class="cart-total">¥ {{totalText}}</view><view class="cart-hint">{{count ? '已选 ' + count + ' 份 · 点击查看' : '选点好吃的，今晚不将就'}}</view></view></view><button class="checkout" disabled="{{tableConfirmed && (!foodCount || !open || diningLoading)}}" bindtap="checkoutOrScan">{{!tableConfirmed ? '先扫码入座' : (open ? '去下单' : '休息中')}} <text>→</text></button></view>
</view>
<view wx:if="{{selected}}" class="overlay" bindtap="closeSelected"><view class="sheet" catchtap="noop"><view class="row between"><text class="section-title">选一份好味</text><view class="sheet-right-action"><button class="close" bindtap="closeSelected">×</button></view></view><view class="selected-dish row"><image src="{{selected.image}}" mode="aspectFill"/><view><view class="section-title">{{selected.name}}</view><view class="subtitle">{{selected.description}}</view><view class="amount">¥{{selected.priceText}}<text class="small muted"> / {{selected.unit}}</text></view></view></view><view class="field-label">{{selected.spicy ? '选择辣度' : '规格'}}</view><view class="chips" wx:if="{{selected.spicy}}"><button wx:for="{{flavors}}" wx:key="*this" class="chip {{flavor === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="flavor">{{item}}</button></view><view wx:else class="chips"><text class="chip selected">标准</text></view><button class="primary sheet-action" bindtap="addSelected">加入购物车 · ¥{{selected.priceText}}</button></view></view>
<view wx:if="{{cartOpen}}" class="overlay" bindtap="closeCart"><view class="sheet" catchtap="noop"><view class="row between"><text class="section-title">这一桌的好味 <text class="small muted">{{count}} 份</text></text><view class="sheet-right-action"><button class="close" bindtap="closeCart">×</button></view></view><view class="row between cart-caption"><text class="small muted">{{tableConfirmed ? tableName + ' 桌' : '未确认桌号'}} · 当前设备的购物车</text><view class="sheet-right-action" wx:if="{{count}}"><button class="text-button" bindtap="clear">清空</button></view></view><scroll-view scroll-y class="sheet-scroll"><view wx:for="{{cart}}" wx:key="key" class="cart-line cart-dish-line"><image wx:if="{{item.image}}" class="cart-dish-image" src="{{item.image}}" mode="aspectFill" aria-label="{{item.name}}"/><view class="cart-dish-details"><view class="row between"><view><view class="cart-name">{{item.name}}</view><view class="small muted">{{item.flavor}}<text wx:if="{{!item.available}}" class="danger"> · 已下架或售罄，请移除</text></view></view><text class="cart-line-price">¥{{item.subtotalText}}</text></view><view class="row between cart-line-bottom"><text class="small muted">¥{{item.priceText}} / {{item.unit}}</text><view class="stepper"><button class="step-button minus" data-id="{{item.id}}" data-flavor="{{item.flavor}}" data-delta="-1" bindtap="step">−</button><text>{{item.quantity}}</text><button class="step-button" data-id="{{item.id}}" data-flavor="{{item.flavor}}" data-delta="1" bindtap="step" disabled="{{!item.available}}">+</button></view></view></view></view><view wx:for="{{diningCart}}" wx:key="id" class="cart-line"><view class="row between"><view class="cart-name">{{item.name}}</view><text class="cart-line-price">¥{{item.subtotalText}}</text></view><view class="row between cart-line-bottom"><text class="small muted">¥{{item.priceText}} / {{item.unit}}</text><view class="stepper"><button class="step-button minus" disabled="{{diningLoading || item.quantity === 0}}" data-id="{{item.id}}" data-delta="-1" bindtap="stepDining">−</button><text>{{item.quantity}}</text><button class="step-button" disabled="{{diningLoading || item.quantity >= 99}}" data-id="{{item.id}}" data-delta="1" bindtap="stepDining">+</button></view></view></view><view wx:if="{{dining && !diningCharged}}" class="dining-add-actions"><button wx:if="{{!dining.cutlery}}" class="text-button" data-id="cutlery" data-delta="1" bindtap="stepDining" disabled="{{diningLoading}}">＋ 添加餐具</button><button wx:if="{{!dining.napkins}}" class="text-button" data-id="napkins" data-delta="1" bindtap="stepDining" disabled="{{diningLoading}}">＋ 添加餐巾纸</button></view><view wx:if="{{!count}}" class="empty-copy">还没选菜，去看看菜单吧。</view></scroll-view><view class="field-label">给后厨捎句话</view><input class="input" maxlength="100" placeholder="例如：少盐、先上饮料" value="{{note}}" bindinput="note"/><view class="row between cart-checkout"><text class="amount">合计 ¥{{totalText}}</text><button class="primary" disabled="{{!tableConfirmed || !foodCount || !open || diningLoading}}" bindtap="submit">{{open ? '提交订单' : '门店休息中'}}</button></view></view></view>

<view wx:if="{{diningOpen}}" class="overlay"><view class="sheet"><view class="section-title">这一桌，几位用餐？</view><view class="subtitle">{{tableName}} 桌 · 同桌只需确认一次</view><view class="field-label">用餐人数</view><view class="dining-options"><button wx:for="{{peopleOptions}}" wx:key="*this" class="dining-option {{people === item ? 'selected' : ''}}" data-field="people" data-value="{{item}}" bindtap="selectDining" disabled="{{diningLoading}}" aria-label="用餐人数{{item}}" aria-pressed="{{people === item}}">{{item}}</button></view><view class="field-label">餐具数量（套，可选0） · ¥{{cutleryPriceText}}／套</view><view class="dining-options"><button wx:for="{{quantityOptions}}" wx:key="*this" class="dining-option {{cutlery === item ? 'selected' : ''}}" data-field="cutlery" data-value="{{item}}" bindtap="selectDining" disabled="{{diningLoading}}" aria-label="餐具数量{{item}}" aria-pressed="{{cutlery === item}}">{{item}}</button></view><view class="field-label">餐巾纸数量（包，可选0） · ¥{{napkinPriceText}}／包</view><view class="dining-options"><button wx:for="{{quantityOptions}}" wx:key="*this" class="dining-option {{napkins === item ? 'selected' : ''}}" data-field="napkins" data-value="{{item}}" bindtap="selectDining" disabled="{{diningLoading}}" aria-label="餐巾纸数量{{item}}" aria-pressed="{{napkins === item}}">{{item}}</button></view><block wx:if="{{feesReady}}"><view class="row between"><text>餐具小计</text><text>¥{{cutleryTotalText}}</text></view><view class="row between"><text>餐巾纸小计</text><text>¥{{napkinTotalText}}</text></view><view class="field-label">本次用餐费用 ¥{{diningTotalText}}</view><view class="subtitle">随首笔订单计入一次，加单不重复收取。</view></block><view wx:else class="notice">门店尚未设置餐具及餐巾纸单价，请联系店员。</view><button class="primary" loading="{{diningLoading}}" disabled="{{!feesReady || diningLoading}}" bindtap="confirmDining">确认人数及费用，开始点餐</button><button class="text-button" bindtap="viewDining">刷新本桌信息</button></view></view>
