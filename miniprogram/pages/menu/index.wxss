.menu-page{height:100vh;display:flex;flex-direction:column;padding-bottom:130rpx}.store-header{padding:25rpx 30rpx 24rpx;flex-shrink:0}.brand{font-size:43rpx;font-weight:700;letter-spacing:3rpx;margin-top:7rpx}.brand-dot{color:#bc4c2c}.table-label{display:flex;flex-direction:column;gap:4rpx;border-left:1rpx solid #dbd0c2;padding-left:25rpx;color:#8a7a67}.table-number{font-size:34rpx;color:#44382b;font-weight:600;letter-spacing:2rpx}.hero{margin:0 26rpx;height:240rpx;border-radius:20rpx;overflow:hidden;position:relative;flex-shrink:0;background:#332a22}.hero-image{position:absolute;right:0;width:72%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#29241eee 0%,#29241ec9 35%,#29241e08 100%)}.hero-copy{position:relative;color:#fff6e9;padding:26rpx 30rpx}.hero-kicker{font-size:19rpx;letter-spacing:3rpx;color:#dfb888}.hero-title{font-size:34rpx;line-height:1.5;font-weight:600;margin:12rpx 0 12rpx}.hero-tag{font-size:18rpx;letter-spacing:3rpx;color:#dbbda1}.menu-info{padding:21rpx 30rpx;font-size:21rpx;color:#8b725b;flex-shrink:0}.menu-info .muted{font-size:19rpx}.menu-body{flex:1;display:flex;min-height:0;border-top:1rpx solid #ede5db}.category-rail{width:142rpx;background:#f0ebe3;height:100%;flex-shrink:0}.category{position:relative;padding:34rpx 14rpx 34rpx 25rpx;color:#8a7f72;font-size:27rpx}.category.active{background:#faf7f2;color:#ac492d;font-weight:600}.category.active::before{content:"";position:absolute;left:0;top:33rpx;width:6rpx;height:34rpx;background:#b94d30;border-radius:0 5rpx 5rpx 0}.category-count{font-size:18rpx;margin-top:7rpx;color:#b0a18c;font-weight:400}.dish-list{height:100%;flex:1;width:0;padding:0 24rpx}.list-heading{padding:24rpx 0 18rpx;font-size:26rpx;font-weight:600}.list-heading .small{font-weight:400;font-size:19rpx}.dish-card{display:flex;gap:18rpx;border-bottom:1rpx solid #eae3d9;padding:20rpx 0}.dish-photo{position:relative;width:166rpx;height:184rpx;flex-shrink:0;border-radius:15rpx;overflow:hidden;background:#e8dfd2}.dish-photo image{height:100%;width:100%}.dish-content{flex:1;min-width:0;padding-top:2rpx}.dish-name{font-size:29rpx;font-weight:600}.dish-description{font-size:20rpx;line-height:1.6;color:#9c9081;margin-top:9rpx;min-height:35rpx}.dish-tag{display:inline-block;color:#aa713f;background:#efe6d6;font-size:17rpx;padding:4rpx 9rpx;border-radius:5rpx;margin-top:9rpx}.dish-bottom{margin-top:14rpx}.dish-bottom .amount{font-size:31rpx}.unit{color:#a39584;font-size:19rpx}.add-button{width:47rpx;height:47rpx;background:#b84a2e;color:white;font-size:36rpx;line-height:43rpx;border-radius:50%;flex-shrink:0}.chosen-count{font-size:18rpx;color:#b44d31;margin-top:6rpx}.sold-mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#29231d80;color:white;font-size:23rpx}.sold .dish-name{color:#9d9284}.list-end{text-align:center;padding:32rpx 0;font-size:18rpx;letter-spacing:2rpx;color:#b5a58f}.cart-bar{position:fixed;bottom:20rpx;left:24rpx;right:24rpx;height:104rpx;background:#2e2a24;border-radius:60rpx;padding:10rpx 10rpx 10rpx 24rpx;box-shadow:0 12rpx 32rpx #29201525;z-index:10}.cart-summary{gap:23rpx;flex:1}.bag-icon{position:relative;color:#e8cba7;font-size:58rpx;line-height:1}.cart-badge{position:absolute;right:-15rpx;top:-5rpx;min-width:30rpx;height:30rpx;border-radius:25rpx;background:#be522f;color:#fff;font-size:19rpx;text-align:center;line-height:30rpx;padding:0 6rpx}.cart-total{color:#fff3e1;font-size:35rpx;font-weight:600}.cart-hint{font-size:18rpx;color:#b6a996;margin-top:5rpx}.checkout{background:#c75a34;color:#fff7e8;border-radius:45rpx;padding:23rpx 30rpx;font-size:27rpx;font-weight:600}.checkout text{margin-left:20rpx}.checkout[disabled]{background:#65574a;opacity:1;color:#b6a796}.selected-dish{gap:22rpx;margin-top:28rpx}.selected-dish image{height:170rpx;width:170rpx;flex-shrink:0;border-radius:18rpx}.selected-dish .amount{margin-top:12rpx}.sheet-action{margin-top:36rpx}.cart-caption{margin:12rpx 0}.cart-line{padding:21rpx 0;border-bottom:1rpx solid #eee5d9}.cart-name{font-size:28rpx;font-weight:500;margin-bottom:9rpx}.cart-line-price{font-size:29rpx;font-weight:600}.cart-line-bottom{margin-top:15rpx}.cart-checkout{margin-top:26rpx}

.menu-stepper{display:flex;align-items:center;gap:10rpx;flex-shrink:0}.menu-stepper .quantity-button{display:flex;align-items:center;justify-content:center;width:44rpx;min-width:44rpx;max-width:44rpx;height:44rpx;margin:0;padding:0;border-radius:50%;font-size:32rpx;line-height:1;background:#b84a2e;color:#fff}.menu-stepper .quantity-button.minus{background:#f2e4d7;color:#a54b31;border:1rpx solid #d4b79f}.menu-stepper .quantity-number{min-width:25rpx;text-align:center;font-size:25rpx;font-weight:600;font-variant-numeric:tabular-nums}.dish-bottom .unit{white-space:nowrap}

.brand{font-size:36rpx;letter-spacing:0;max-width:470rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.store-actions{display:flex;flex-direction:column;align-items:flex-end;flex-shrink:0;margin-left:auto}.store-actions .text-button{display:flex;justify-content:flex-end;width:100%;margin:0;text-align:right;white-space:nowrap}.store-actions .table-label{width:100%;align-items:flex-end}

/* 固定购物车步进按钮尺寸，避免原生 mini 按钮的内边距撑宽。 */
.cart-line .step-button{display:flex;align-items:center;justify-content:center;flex:0 0 48rpx;width:48rpx;min-width:48rpx;max-width:48rpx;height:48rpx;min-height:48rpx;max-height:48rpx;margin:0;padding:0;box-sizing:border-box;border-radius:50%;line-height:1}

/* 原生按钮默认左右 auto margin 会把右侧操作拉回中间，显式靠右。 */
.cart-checkout > .primary{margin-left:auto;margin-right:0;flex-shrink:0}

.sheet-right-action{width:72rpx;margin-left:auto;flex-shrink:0;display:flex;justify-content:flex-end}.sheet-right-action .close,.sheet-right-action .text-button{width:72rpx;min-width:0;margin:0;padding-left:0;padding-right:0;text-align:right}

/* 四字分区名称在侧栏保持一行。 */
.category{font-size:24rpx;padding-left:22rpx;padding-right:12rpx;white-space:nowrap}

.dining-options{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-bottom:18rpx}
.dining-options .dining-option{display:flex;align-items:center;justify-content:center;flex:0 0 60rpx;width:60rpx;min-width:60rpx;height:60rpx;margin:0;padding:0;border:2rpx solid #e4d8c9;border-radius:50%;background:#f5f0e8;color:#6d5745;font-size:27rpx;line-height:1}
.dining-options .dining-option.selected{background:#ba4b2d;border-color:#ba4b2d;color:#fffaf2;font-weight:600}

.dining-add-actions{display:flex;gap:28rpx;padding-top:12rpx}

.cart-dish-line{display:flex;align-items:center;gap:18rpx}
.cart-dish-image{width:120rpx;height:120rpx;flex-shrink:0;border-radius:12rpx;background:#e8dfd2}
.cart-dish-details{flex:1;min-width:0}
.cart-dish-details .cart-name{overflow-wrap:break-word}
.cart-dish-details .cart-line-price{flex-shrink:0;margin-left:12rpx}
.cart-dish-details .cart-line-bottom{gap:10rpx}
.cart-dish-details .stepper{gap:14rpx;flex-shrink:0}

.store-actions .table-scan{background:transparent;border-radius:0;margin:0;line-height:1.5;padding-top:0;padding-bottom:0;padding-right:0}.table-scan::after{border:0}.scan-hint{font-size:21rpx;color:#b84a2e;font-weight:500}
