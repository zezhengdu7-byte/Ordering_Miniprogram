<block wx:if="{{authorized}}"><view class="page table-page"><view class="eyebrow">QR CODES · TABLES</view><view class="row between"><view class="page-title">桌码管理</view><button class="primary small-button" bindtap="add">＋ 新建桌台</button></view><view class="notice">管理每张桌子的固定桌码，桌台经营和本桌订单请前往“经营管理 → 桌台管理”。</view><view class="subtitle">每桌固定一码，结束用餐和下一批客人扫码都不换码。</view><button class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="batchGenerate">生成／补齐 A01–A30 桌码</button><view class="subtitle">{{progress}}</view><view wx:if="{{error}}" class="notice">{{error}}<button bindtap="refresh">重新加载</button></view>
<view wx:for="{{tables}}" wx:key="id" class="card table-card"><view class="row between"><view class="table-name">{{item.name}} 桌</view><view class="status-group"><text class="pill">{{item.currentSessionId ? '用餐中' : '空桌'}}</text><text wx:if="{{!item.qrEnabled}}" class="pill off">桌码已停用</text></view></view><image wx:if="{{item.codeFileID}}" style="width:220rpx;height:220rpx" mode="aspectFit" src="{{item.codeFileID}}" data-id="{{item.id}}" bindtap="code"/><view class="subtitle">{{item.codeFileID ? '正式桌码已保存' : '尚未生成桌码'}}</view><view class="table-actions"><button class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="code">查看／生成桌码</button><button class="text-button" data-id="{{item.id}}" bindtap="toggleCode">{{item.qrEnabled ? '停用桌码' : '启用桌码'}}</button><button wx:if="{{item.currentSessionId}}" class="text-button" data-id="{{item.id}}" data-action="close" bindtap="confirmAction">结束用餐</button><button class="text-button muted" data-id="{{item.id}}" data-action="remove" bindtap="confirmAction">删除</button></view></view><view wx:if="{{!tables.length ? !error : false}}" class="notice">还没有云端桌台，请先新建。</view></view>
<view wx:if="{{editorOpen}}" class="overlay" bindtap="close"><view class="sheet" catchtap="noop"><view class="section-title">新建云端桌台</view><input class="input" maxlength="12" placeholder="例如 A06、包间1" value="{{name}}" bindinput="input"/><button class="primary" loading="{{busy}}" bindtap="save">保存并生成桌码</button><button bindtap="close">关闭</button></view></view>
<view wx:if="{{detail}}" class="overlay" bindtap="close"><view class="sheet" catchtap="noop"><view class="section-title">{{detail.name}} 桌 · 正式版</view><image style="width:100%;height:520rpx" mode="aspectFit" src="{{detail.path}}" bindtap="preview"/><button class="primary" bindtap="saveImage">保存桌码到相册</button><button bindtap="close">关闭</button></view></view></block>
