<block wx:if="{{authorized}}">
<view class="merchant-hero"><view class="hero-kicker">炭火里 · 菜单经营</view><view class="row between"><view class="hero-title">菜品管理</view><view class="hero-symbol">菜</view></view><view class="hero-description">把每一道好味，安排妥当。</view><view class="hero-bottom row between"><text>共 {{totalCount}} 款菜品</text><button bindtap="openCategories">分区管理 ↗</button></view></view>
<view class="merchant-body has-bottom"><view class="demo-label">{{simulatorPreview ? '开发工具本地演示 · 未验证商家身份' : '云端数据 · 多设备同步'}}</view>
<view class="metric-card"><view><text class="metric-value">{{sellingCount}}</text><text class="metric-label">售卖中</text></view><view><text class="metric-value amber">{{soldCount}}</text><text class="metric-label">已售罄</text></view><view><text class="metric-value muted">{{offCount}}</text><text class="metric-label">已下架</text></view></view>
<view class="search-box"><text class="search-symbol">⌕</text><input placeholder="搜索菜品名称" value="{{keyword}}" bindinput="search"/></view>
<view class="segmented"><button class="{{statusFilter === 'all' ? 'selected' : ''}}" data-id="all" bindtap="statusFilter">全部菜品</button><button class="{{statusFilter === 'selling' ? 'selected' : ''}}" data-id="selling" bindtap="statusFilter">售卖中</button><button class="{{statusFilter === 'sold' ? 'selected' : ''}}" data-id="sold" bindtap="statusFilter">已售罄</button><button class="{{statusFilter === 'off' ? 'selected' : ''}}" data-id="off" bindtap="statusFilter">已下架</button></view>
<scroll-view scroll-x class="category-scroll"><view class="category-filters"><button class="{{categoryId === 'all' ? 'active' : ''}}" data-id="all" bindtap="category">全部分区</button><button wx:for="{{categories}}" wx:key="id" class="{{categoryId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}<text>{{item.count}}</text></button></view></scroll-view>
<view class="list-heading row between"><text class="workspace-heading">菜品列表</text><text class="small muted">{{dishes.length}} 款</text></view>
<view wx:for="{{dishes}}" wx:key="id" class="merchant-card dish-card"><view class="row dish-main"><view class="dish-photo"><image src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="editDish"/><view wx:if="{{item.soldOut}}" class="photo-label">已售罄</view></view><view class="dish-info"><view class="row between"><text class="dish-name">{{item.name}}</text><text class="status-badge {{item.state}}">{{item.state === 'off' ? '已下架' : item.state === 'sold' ? '已售罄' : '售卖中'}}</text></view><view class="dish-category">{{item.categoryName}}<text wx:if="{{item.categoryOff}}"> · 分区已下架</text></view><view class="dish-description">{{item.description}}</view><view class="dish-price">¥{{item.priceText}}<text> / {{item.unit}}</text></view></view></view><view class="dish-actions"><button data-id="{{item.id}}" data-field="onSale" bindtap="status">{{item.onSale ? '下架' : '上架'}}</button><button data-id="{{item.id}}" data-field="soldOut" bindtap="status">{{item.soldOut ? '恢复供应' : '设为售罄'}}</button><button class="accent-action" data-id="{{item.id}}" bindtap="editDish">编辑</button><button class="delete-action" data-id="{{item.id}}" bindtap="deleteDish">删除</button></view></view>
<view wx:if="{{!dishes.length}}" class="merchant-card empty"><view class="empty-mark">▤</view><view class="empty-title">{{totalCount ? '没有找到菜品' : '添上第一道招牌菜'}}</view><view class="empty-copy">{{totalCount ? '试试其他分区或搜索词，也可以新增菜品。' : '先创建分区，再把店里的好味放上菜单。'}}</view></view>
<view class="merchant-foot">认真备菜，好好经营。</view></view><view class="bottom-bar"><button class="primary" bindtap="addDish">＋ 新增菜品</button></view></block>
