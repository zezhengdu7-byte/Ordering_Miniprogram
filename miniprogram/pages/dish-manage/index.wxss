@import "../../utils/merchant.wxss";
.category-scroll{width:100%;white-space:nowrap;margin:22rpx 0}.category-filters{display:inline-flex;gap:14rpx;min-width:100%}.category-filters button{flex:0 0 auto;width:auto;padding:12rpx 23rpx;border:1rpx solid #e9e1d6;border-radius:30rpx;background:#fffdfa;color:#8a7b6c;font-size:23rpx}.category-filters button.active{background:#f7e7df;color:#b84c32;border-color:#e3b6a5}.category-filters text{margin-left:10rpx;font-size:19rpx;opacity:.7}.dish-main{gap:20rpx;align-items:flex-start}.dish-photo{width:140rpx;height:148rpx;position:relative;flex-shrink:0;border-radius:12rpx;overflow:hidden;background:#eee7dd}.dish-photo image{width:100%;height:100%}.photo-label{position:absolute;bottom:0;left:0;right:0;background:#3b3027b8;text-align:center;color:#fff7e8;font-size:20rpx;padding:6rpx}.dish-info{flex:1;min-width:0}.dish-name{font-size:27rpx;font-weight:600;flex:1;min-width:0;margin-right:10rpx;overflow-wrap:break-word}.dish-category{font-size:20rpx;color:#a28e7a;margin:9rpx 0}.dish-description{font-size:20rpx;color:#a69889;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.5}.dish-price{font-size:32rpx;color:#b84c32;font-weight:600;margin-top:10rpx}.dish-price text{font-size:20rpx;color:#aa9a89;font-weight:400}.dish-actions{display:flex;border-top:1rpx solid #f0e8dd;margin-top:22rpx;padding-top:16rpx;gap:12rpx}.dish-actions button{flex:1;font-size:22rpx;padding:10rpx 0;border-radius:8rpx;background:#f5f1eb;color:#766654;white-space:nowrap}.dish-actions .accent-action{color:#b84c32;background:#fbede6}.dish-actions .delete-action{color:#a38476;background:transparent}
