<block wx:if="{{authorized}}"><view class="merchant-hero"><view class="hero-kicker">炭火里 · 订单处理</view><view class="row between"><view class="hero-title">{{tableName}} 桌</view><view class="hero-symbol">单</view></view><view class="hero-description">本次用餐的全部订单与消费</view><view class="hero-bottom row between"><text>{{shopName}}</text><text>接单 · 制作 · 出餐</text></view></view>
<view class="merchant-body"><view wx:if="{{error}}" class="merchant-card session-error">{{error}}</view><view class="merchant-card table-session-summary"><view class="row between"><text>{{sessionEnded ? '本次用餐已结束' : tableOccupied ? '用餐中' : '空桌'}}</text><text class="amount">¥{{tableTotalText}}</text></view><view wx:if="{{!sessionEnded && tableSessionId}}" class="subtitle">{{unfinishedCount ? '还有订单未完成' : unpaidCount ? '订单已完成，结束用餐时请确认是否结清' : '订单已完成并结算，可结束用餐'}}</view><button wx:if="{{tableSessionId && !sessionEnded}}" class="primary end-dining" loading="{{ending}}" disabled="{{tableLoading || ending || unfinishedCount || error}}" bindtap="endDining">{{tableLoading ? '加载中' : ending ? '正在结束用餐' : error ? '数据加载失败，请刷新' : unfinishedCount ? '订单完成后可结束用餐' : '结束用餐'}}</button></view><view class="demo-label">{{simulatorPreview ? '开发工具本地演示 · 未验证商家身份' : '云端数据 · 多设备同步'}}</view>
<view class="segmented order-tabs"><button wx:for="{{filters}}" wx:key="id" class="{{filter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view><view class="list-heading row between"><text class="workspace-heading">订单列表</text><text class="small muted">{{orders.length}} 笔订单</text></view>
<view wx:for="{{orders}}" wx:key="id" class="merchant-card merchant-order"><view class="row between"><view class="row order-id"><text class="table-label">{{item.table}} 桌</text></view><text class="status-badge {{item.status}}">{{item.statusText}}</text></view><view class="order-time">下单时间 {{item.timeText}}</view><view class="order-items"><view wx:for="{{item.items}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="dishIndex" class="order-line row between"><view class="order-item-name">{{dish.name}}<text class="order-flavor">{{dish.flavor}}</text></view><text class="order-quantity">×{{dish.quantity}}</text><text class="line-price">¥{{dish.priceText}}</text></view></view><view wx:if="{{item.note}}" class="order-note">备注 · {{item.note}}</view><view class="order-total row between"><text class="payment-label">{{item.status === 'cancelled' ? (item.paid ? '已取消 · 保留模拟付款记录' : '订单已取消') : (item.paid ? '已模拟付款' : '未付款')}}</text><view class="total-label">合计 <text>¥{{item.totalText}}</text></view></view><view class="merchant-order-actions row"><button wx:if="{{item.status === 'pending' || item.status === 'accepted'}}" class="cancel-action" data-id="{{item.id}}" data-status="cancelled" bindtap="action">取消订单</button><button wx:if="{{(item.status === 'pending' || item.status === 'accepted') && !item.paid}}" class="cancel-action" data-id="{{item.id}}" bindtap="edit">修改订单</button><button wx:if="{{item.status === 'pending'}}" class="primary" data-id="{{item.id}}" data-status="accepted" bindtap="action">接单制作</button><button wx:if="{{item.status === 'accepted'}}" class="primary" data-id="{{item.id}}" data-status="completed" bindtap="action">完成出餐</button></view></view>
<view wx:if="{{!orders.length}}" class="merchant-card empty"><view class="empty-mark">▤</view><view class="empty-title">{{keyword ? '没有找到订单' : filter === 'all' ? '还没有订单' : '暂无此状态的订单'}}</view><view class="empty-copy">{{keyword ? '试试其他桌号或菜品名称' : '顾客提交订单后，就可以在这里接单和处理'}}</view></view><view class="merchant-foot">仅显示本次用餐订单，结束用餐后历史记录仍保留</view></view>

</block>

<include src="../../utils/order-edit.wxml"/>
