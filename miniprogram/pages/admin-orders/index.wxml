<block wx:if="{{authorized}}"><view class="merchant-hero"><view class="hero-kicker">炭火里 · 订单处理</view><view class="row between"><view class="hero-title">订单管理</view><view class="hero-symbol">单</view></view><view class="hero-description">接好每一单，留住每一桌烟火。</view><view class="hero-bottom row between"><text>{{shopName}}</text><text>接单 · 制作 · 出餐</text></view></view>
<view class="merchant-body"><view class="demo-label">{{simulatorPreview ? '开发工具本地演示 · 未验证商家身份' : '云端数据 · 多设备同步'}}</view><view class="metric-card"><view><text class="metric-value">{{pendingCount}}</text><text class="metric-label">待接单</text></view><view><text class="metric-value amber">{{makingCount}}</text><text class="metric-label">制作中</text></view><view><text class="metric-value">{{completedCount}}</text><text class="metric-label">已完成</text></view></view><view class="search-box"><text class="search-symbol">⌕</text><input placeholder="搜索订单号、桌号、菜品" value="{{keyword}}" bindinput="search"/></view>
<view class="segmented order-tabs"><button wx:for="{{filters}}" wx:key="id" class="{{filter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view><view class="list-heading row between"><text class="workspace-heading">订单列表</text><text class="small muted">{{orders.length}} 笔订单</text></view>
<view wx:for="{{orders}}" wx:key="id" class="merchant-card merchant-order"><view class="row between"><view class="row order-id"><text class="table-label">{{item.table}} 桌</text><text class="order-number">#{{item.number}}</text></view><text class="status-badge {{item.status}}">{{item.statusText}}</text></view><view class="order-time">下单时间 {{item.timeText}}</view><view class="order-items"><view wx:for="{{item.items}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="dishIndex" class="order-line row between"><view class="order-item-name">{{dish.name}}<text class="order-flavor">{{dish.flavor}}</text></view><text class="order-quantity">×{{dish.quantity}}</text><text class="line-price">¥{{dish.priceText}}</text></view></view><view wx:if="{{item.note}}" class="order-note">备注 · {{item.note}}</view><view class="order-total row between"><text class="payment-label">{{item.status === 'cancelled' ? (item.paid ? '已取消 · 保留模拟付款记录' : '订单已取消') : (item.paid ? '已模拟付款' : '未付款')}}</text><view class="total-label">合计 <text>¥{{item.totalText}}</text></view></view><view class="merchant-order-actions row"><button class="receipt-action" data-id="{{item.id}}" bindtap="receipt">小票预览</button><button wx:if="{{item.status === 'pending' || item.status === 'accepted'}}" class="cancel-action" data-id="{{item.id}}" data-status="cancelled" bindtap="action">取消订单</button><button wx:if="{{item.status === 'pending'}}" class="primary" data-id="{{item.id}}" data-status="accepted" bindtap="action">接单制作</button><button wx:if="{{item.status === 'accepted'}}" class="primary" data-id="{{item.id}}" data-status="completed" bindtap="action">完成出餐</button></view></view>
<view wx:if="{{!orders.length}}" class="merchant-card empty"><view class="empty-mark">▤</view><view class="empty-title">{{keyword ? '没有找到订单' : filter === 'all' ? '还没有订单' : '暂无此状态的订单'}}</view><view class="empty-copy">{{keyword ? '试试其他订单号、桌号或菜品名称。' : '顾客提交订单后，就可以在这里接单和处理。'}}</view></view><view class="merchant-foot">本地演示 · 付款不扣款 · 小票仅预览</view></view>
<view wx:if="{{receipt}}" class="overlay" bindtap="closeReceipt"><view class="sheet" catchtap="noop"><view class="row between"><text class="section-title">厨房小票预览</text><button class="close" bindtap="closeReceipt">×</button></view><scroll-view scroll-y class="sheet-scroll receipt"><view class="receipt-title">{{shopName}}</view><view class="receipt-table">{{receipt.table}} 桌 / {{receipt.number}}</view><view class="receipt-time">{{receipt.timeText}}</view><view class="receipt-rule"/><view wx:for="{{receipt.items}}" wx:key="index" class="receipt-item row between"><view>{{item.name}}<view class="small muted">{{item.flavor}}</view></view><text>× {{item.quantity}}</text></view><view class="receipt-rule"/><view wx:if="{{receipt.note}}">备注：{{receipt.note}}</view><view class="receipt-bottom">仅预览 · 未发送至打印机</view></scroll-view><button class="primary" bindtap="closeReceipt" style="margin-top:24rpx">知道了</button></view></view>

</block>
