<view class="page"><view class="eyebrow">{{merchant ? 'KITCHEN & ORDERS' : 'YOUR GOOD TASTE'}}</view><view class="page-title">{{merchant ? '每一单，都照顾好。' : '好味，正在路上'}}</view>
<view class="order-filters row"><button wx:for="{{filters}}" wx:key="id" class="order-filter {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view>
<view wx:if="{{!orders.length}}" class="empty"><view class="empty-mark">▤</view><view class="empty-title">{{filter === 'all' ? '还没有订单' : '这个状态下还没有订单'}}</view><view class="empty-copy">{{merchant ? '顾客提交订单后，会出现在这里。' : '去选几道喜欢的菜，开启这一餐。'}}</view><button class="primary" bindtap="toMenu">去菜单看看</button></view>
<view wx:for="{{orders}}" wx:key="id" class="card order-card"><view class="row between"><view class="order-number">{{item.table}} 桌<text wx:if="{{merchant && item.source === 'merchant-assist'}}" class="pill assist-order-pill">商家代下</text></view><text class="pill {{item.status === 'completed' ? 'green' : 'accent'}}">{{item.statusText}}</text></view><view class="small muted" style="margin-top:12rpx">{{item.timeText}}</view><view class="divider"/><view wx:for="{{item.items}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="dishIndex" class="order-dish row between"><view><view>{{dish.name}} <text class="muted small">×{{dish.quantity}}</text></view><view wx:if="{{dish.flavor}}" class="flavor small muted">{{dish.flavor}}</view></view><text>¥{{dish.priceText}}</text></view><view wx:if="{{item.note}}" class="order-note">备注：{{item.note}}</view><view class="divider"/><view class="row between"><text class="small muted">{{item.status === 'cancelled' ? (item.paid ? '已取消 · 保留模拟付款记录' : '订单已取消') : (item.paid ? '已模拟付款 · 无真实扣款' : '未付款')}}</text><view class="amount"><text class="small muted">合计 </text>¥{{item.totalText}}</view></view><view class="order-actions row">
<button wx:if="{{!merchant && !item.paid && item.status === 'pending'}}" class="secondary" data-id="{{item.id}}" data-status="cancelled" bindtap="action">取消订单</button>
<button wx:if="{{!merchant && !item.paid && item.status === 'pending'}}" class="primary" data-id="{{item.id}}" bindtap="edit">修改订单</button>
<button wx:if="{{merchant && (item.status === 'pending' || item.status === 'accepted')}}" class="secondary" data-id="{{item.id}}" data-status="cancelled" bindtap="action">取消订单</button>
<button wx:if="{{merchant && (item.status === 'pending' || item.status === 'accepted') && !item.paid}}" class="secondary" data-id="{{item.id}}" bindtap="edit">修改订单</button>
<button wx:if="{{merchant && item.status === 'pending'}}" class="primary" data-id="{{item.id}}" data-status="accepted" bindtap="action">接单制作</button>
<button wx:if="{{merchant && item.status === 'accepted'}}" class="primary" data-id="{{item.id}}" data-status="completed" bindtap="action">完成出餐</button></view></view><view wx:if="{{!merchant && bill && bill.count}}" class="card"><view class="row between"><text>{{bill.table}} 桌 · 统一结算</text><text class="amount">¥{{bill.totalText}}</text></view><view wx:if="{{bill.unfinished}}" class="subtitle">还有 {{bill.unfinished}} 笔订单未完成，完成后可结算</view><button class="primary" style="margin-top:20rpx" disabled="{{bill.unfinished || settling}}" loading="{{settling}}" bindtap="pay">整桌结算</button></view><view class="footer-note">热乎的菜，慢慢吃</view></view>

<include src="./order-edit.wxml"/>
