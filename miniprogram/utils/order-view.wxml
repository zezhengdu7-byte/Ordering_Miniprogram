<view class="page"><view class="eyebrow">{{merchant ? 'KITCHEN & ORDERS' : 'YOUR GOOD TASTE'}}</view><view class="page-title">{{merchant ? '每一单，都照顾好。' : '好味，正在路上。'}}</view><view class="subtitle">{{merchant ? '云端门店订单工作台' : '我的云端订单'}}</view><view class="notice" style="margin-top:24rpx">订单已同步云端；付款为模拟操作，未接入真实支付及打印。</view>
<input wx:if="{{merchant}}" class="input order-search" placeholder="搜索订单号、桌号、菜品" value="{{keyword}}" bindinput="search"/><view class="order-filters row"><button wx:for="{{filters}}" wx:key="id" class="order-filter {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view>
<view wx:if="{{!orders.length}}" class="empty"><view class="empty-mark">▤</view><view class="empty-title">{{filter === 'all' ? '还没有订单' : '这个状态下还没有订单'}}</view><view class="empty-copy">{{merchant ? '顾客提交订单后，会出现在这里。' : '去选几道喜欢的菜，开启这一餐。'}}</view><button class="primary" bindtap="toMenu">去菜单看看</button></view>
<view wx:for="{{orders}}" wx:key="id" class="card order-card"><view class="row between"><view class="order-number">{{item.number}} <text class="small muted">· {{item.table}} 桌</text></view><text class="pill {{item.status === 'completed' ? 'green' : 'accent'}}">{{item.statusText}}</text></view><view class="small muted" style="margin-top:12rpx">{{item.timeText}}</view><view class="divider"/><view wx:for="{{item.items}}" wx:for-item="dish" wx:for-index="dishIndex" wx:key="dishIndex" class="order-dish row between"><view><view>{{dish.name}} <text class="muted small">×{{dish.quantity}}</text></view><view class="flavor small muted">{{dish.flavor}}</view></view><text>¥{{dish.priceText}}</text></view><view wx:if="{{item.dining}}" class="order-note">用餐 {{item.dining.people}} 人 · 餐具 {{item.dining.cutlery}} 套 · 餐巾纸 {{item.dining.napkins}} 份<view wx:if="{{item.dining.charged}}">餐具 ¥{{item.cutleryFeeText}} · 餐巾纸 ¥{{item.napkinFeeText}} · 合计 ¥{{item.diningFeeText}}（已计入订单）</view><view wx:else>餐具、餐巾纸费用已在本次用餐其他订单计入，本单不重复收取。</view></view><view wx:if="{{item.note}}" class="order-note">备注：{{item.note}}</view><view class="divider"/><view class="row between"><text class="small muted">{{item.status === 'cancelled' ? (item.paid ? '已取消 · 保留模拟付款记录' : '订单已取消') : (item.paid ? '已模拟付款 · 无真实扣款' : '未付款')}}</text><view class="amount"><text class="small muted">合计 </text>¥{{item.totalText}}</view></view><view class="order-actions row">
<button wx:if="{{!merchant && !item.paid && item.status === 'pending'}}" class="secondary" data-id="{{item.id}}" data-status="cancelled" bindtap="action">取消订单</button>
<button wx:if="{{!merchant && !item.paid && item.status !== 'cancelled'}}" class="primary" data-id="{{item.id}}" bindtap="pay">模拟付款</button>
<button wx:if="{{merchant}}" class="secondary" data-id="{{item.id}}" bindtap="receipt">小票预览</button>
<button wx:if="{{merchant && item.status === 'pending' && !item.paid}}" class="secondary" data-id="{{item.id}}" data-status="cancelled" bindtap="action">拒绝</button>
<button wx:if="{{merchant && item.status === 'pending'}}" class="primary" data-id="{{item.id}}" data-status="accepted" bindtap="action">接单制作</button>
<button wx:if="{{merchant && item.status === 'accepted'}}" class="primary" data-id="{{item.id}}" data-status="completed" bindtap="action">完成出餐</button></view></view><view class="footer-note">热乎的菜，慢慢吃</view></view>
<view wx:if="{{receipt}}" class="overlay" bindtap="closeReceipt"><view class="sheet" catchtap="noop"><view class="row between"><text class="section-title">厨房小票预览</text><button class="close" bindtap="closeReceipt">×</button></view><scroll-view scroll-y class="sheet-scroll receipt"><view class="receipt-title">{{shopName}}</view><view class="receipt-table">{{receipt.table}} 桌 / {{receipt.number}}</view><view wx:if="{{receipt.dining}}">用餐{{receipt.dining.people}}人 · 餐具{{receipt.dining.cutlery}}套 · 餐巾纸{{receipt.dining.napkins}}份 · 本单费用¥{{receipt.diningFeeText}}</view><view class="receipt-time">{{receipt.timeText}}</view><view class="receipt-rule"/><view wx:for="{{receipt.items}}" wx:key="index" class="receipt-item row between"><view>{{item.name}}<view class="small muted">{{item.flavor}}</view></view><text>× {{item.quantity}}</text></view><view class="receipt-rule"/><view wx:if="{{receipt.note}}">备注：{{receipt.note}}</view><view class="receipt-bottom">仅预览 · 未发送至打印机</view></scroll-view><button class="primary" bindtap="closeReceipt" style="margin-top:24rpx">知道了</button></view></view>
