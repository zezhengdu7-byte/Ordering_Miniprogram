<view wx:if="{{editing}}" class="overlay" bindtap="closeEdit"><view class="sheet order-edit-sheet" catchtap="noop"><view class="row between edit-header"><text class="section-title">修改订单 · {{editing.table}} 桌</text><view class="edit-right-action edit-close-action"><button class="close" bindtap="closeEdit">×</button></view></view><scroll-view scroll-y class="sheet-scroll"><view wx:for="{{editing.items}}" wx:key="index" class="order-dish row between"><view class="edit-dish-info"><view>{{item.name}}</view><picker wx:if="{{item.canEditFlavor}}" range="{{editFlavors}}" data-index="{{index}}" bindchange="editFlavor" disabled="{{editSaving}}"><view class="edit-flavor-picker">{{item.flavor}} ▾</view></picker><text class="small muted"><text wx:if="{{item.flavor && !item.canEditFlavor}}">{{item.flavor}} · </text> ¥{{item.unitPriceText}}/{{item.unit}}</text></view><view class="stepper"><button class="step-button minus" disabled="{{editSaving || !item.quantity}}" data-index="{{index}}" data-delta="-1" bindtap="editStep">−</button><text>{{item.quantity}}</text><button class="step-button" disabled="{{editSaving || item.quantity >= 99}}" data-index="{{index}}" data-delta="1" bindtap="editStep">+</button></view></view></scroll-view><view class="field-label">{{merchant ? '给后厨的备注' : '备注'}}</view><input class="input" value="{{editing.note}}" maxlength="100" bindinput="editNote"/><view class="row between" style="margin-top:24rpx"><text class="amount">合计 ¥{{editing.totalText}}</text><view class="edit-right-action"><button class="primary edit-save" disabled="{{editSaving}}" loading="{{editSaving}}" bindtap="saveEdit">保存修改</button></view></view></view></view>
