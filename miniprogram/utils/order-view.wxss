.page-title{font-size:43rpx}.order-filters{gap:13rpx;margin-top:30rpx}.order-filter{padding:15rpx 23rpx;background:#eee7dc;border-radius:35rpx;font-size:24rpx;color:#8c7961}.order-filter.active{background:#302b25;color:#fff3df}.order-number{font-size:32rpx;font-weight:600}.order-card{margin-top:24rpx}.order-dish{margin:22rpx 0;font-size:27rpx}.flavor{margin-top:6rpx}.order-note{font-size:23rpx;padding:16rpx;background:#f4eee3;border-radius:8rpx;color:#8c7355}.order-actions{justify-content:flex-end;gap:13rpx;margin-top:25rpx}.order-actions button{font-size:24rpx;padding:17rpx 24rpx}.receipt{margin-top:22rpx;background:#fff;padding:25rpx;font-family:monospace}.receipt-title{font-size:36rpx;text-align:center}.receipt-table{font-size:40rpx;font-weight:700;text-align:center;margin:25rpx 0 16rpx}.receipt-time{text-align:center;color:#999;font-size:23rpx}.receipt-rule{border-top:2rpx dashed #c8c1b5;margin:26rpx 0}.receipt-item{font-size:28rpx;margin:23rpx 0}.receipt-bottom{text-align:center;color:#999;font-size:23rpx;margin:30rpx 0}

.order-search{margin-top:25rpx}.order-filters{gap:8rpx}.order-filter{flex:1;white-space:nowrap;padding:15rpx 6rpx;font-size:22rpx}
.assist-order-pill{display:inline-block;margin-left:10rpx;padding:4rpx 8rpx;font-size:16rpx;line-height:1.3;vertical-align:middle}

.order-edit-sheet .edit-dish-info{flex:1;min-width:0;margin-right:20rpx}
.order-edit-sheet .stepper{display:flex;align-items:center;flex-shrink:0;gap:18rpx}
.order-edit-sheet .step-button{display:flex;align-items:center;justify-content:center;flex:0 0 48rpx;width:48rpx;min-width:48rpx;max-width:48rpx;height:48rpx;min-height:48rpx;max-height:48rpx;margin:0;padding:0;box-sizing:border-box;border-radius:50%;line-height:1}
.order-edit-sheet .stepper text{min-width:30rpx;text-align:center;font-variant-numeric:tabular-nums}
.order-edit-sheet .close{margin-left:auto;margin-right:0}

.edit-flavor-picker{display:inline-block;color:#b84c32;background:#f5e9de;padding:8rpx 14rpx;border-radius:8rpx;font-size:23rpx;margin-top:8rpx;margin-bottom:6rpx}

.order-edit-sheet .edit-right-action{display:flex;justify-content:flex-end;margin-left:auto;flex-shrink:0}.order-edit-sheet .edit-right-action button{margin:0}.order-edit-sheet .edit-save{width:350rpx}

.order-edit-sheet .edit-header{position:relative;min-height:64rpx;padding-right:72rpx}.order-edit-sheet .edit-close-action{position:absolute;right:0;top:0;width:64rpx;height:64rpx}.order-edit-sheet .edit-close-action .close{display:flex;align-items:center;justify-content:center;width:64rpx;min-width:64rpx;max-width:64rpx;height:64rpx;padding:0;margin:0}
