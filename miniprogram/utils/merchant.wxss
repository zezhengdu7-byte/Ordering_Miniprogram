page{background:#f5f3ee;color:#392f26}.merchant-hero{background:#b84c32;color:#fff8ee;padding:30rpx 32rpx 22rpx}.hero-kicker{font-size:20rpx;letter-spacing:2rpx;color:#f1cdb9}.hero-title{font-size:44rpx;font-weight:700;margin:12rpx 0 6rpx}.hero-description{font-size:23rpx;color:#ffe0cf;line-height:1.7}.hero-symbol{width:65rpx;height:65rpx;border:1rpx solid #edb49c;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;color:#f5c7ae;transform:rotate(6deg);margin-right:4rpx}.hero-bottom{border-top:1rpx solid #ffffff26;padding-top:18rpx;margin-top:22rpx;font-size:21rpx;color:#ffe8d5}.hero-bottom button{width:auto;font-size:21rpx;color:#fff3e8;padding:6rpx 0}.merchant-body{padding:0 26rpx 30rpx}.has-bottom{padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.demo-label{font-size:19rpx;color:#a18e7a;padding:18rpx 3rpx;line-height:1.6}.metric-card{display:flex;background:#fffdfa;border:1rpx solid #eee7dd;border-radius:20rpx;padding:24rpx 0;margin-bottom:22rpx}.metric-card>view{flex:1;text-align:center;display:flex;flex-direction:column;gap:8rpx}.metric-card>view+view{border-left:1rpx solid #eee7dd}.metric-value{font-size:38rpx;font-weight:700;line-height:1.2;color:#392e25;font-variant-numeric:tabular-nums}.metric-value.amber{color:#bf9249}.metric-value.muted{color:#9b8d7b}.metric-label{font-size:21rpx;color:#a18f7d}.search-box{display:flex;align-items:center;border:1rpx solid #eae3d9;border-radius:14rpx;background:#fffdfa;padding:0 22rpx;gap:13rpx;height:80rpx;margin-bottom:22rpx}.search-symbol{font-size:37rpx;color:#ab9c8b}.search-box input{flex:1;min-width:0;font-size:24rpx;height:76rpx}.segmented{display:flex;background:#eae6de;padding:6rpx;border-radius:14rpx;gap:4rpx}.segmented button{flex:1;padding:16rpx 0;border-radius:10rpx;font-size:23rpx;color:#8f7e6c;white-space:nowrap}.segmented button.selected{background:#fffdfa;color:#b84c32;font-weight:600;box-shadow:0 2rpx 6rpx #59412d08}.list-heading{margin:28rpx 0 18rpx}.workspace-heading{display:flex;align-items:center;font-size:27rpx;font-weight:600;gap:12rpx}.workspace-heading::before{content:'';width:5rpx;height:24rpx;background:#b84c32;border-radius:4rpx}.merchant-card{background:#fffdfa;border:1rpx solid #eee7dd;border-radius:20rpx;padding:24rpx;margin-bottom:18rpx}.status-badge{font-size:18rpx;border-radius:6rpx;padding:6rpx 10rpx;white-space:nowrap;flex-shrink:0;background:#edf2e9;color:#6e8a66}.status-badge.sold{background:#faf0dc;color:#b48d42}.status-badge.off,.status-badge.cancelled{background:#f0ece6;color:#9e9081}.status-badge.pending{background:#fae8df;color:#b84c32}.status-badge.accepted{background:#faf0dc;color:#b48d42}.bottom-bar{position:fixed;bottom:0;left:0;right:0;padding:18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));background:#fffdf9;border-top:1rpx solid #eee7dd;z-index:10}.bottom-bar .primary{width:100%;font-size:27rpx;padding:23rpx;border-radius:14rpx}.merchant-foot{font-size:20rpx;color:#b4a797;letter-spacing:2rpx;text-align:center;margin:34rpx 0 20rpx}
