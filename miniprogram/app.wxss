page{background:#faf7f2;color:#292722;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;--accent:#ba4b2d;--muted:#928a80}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;padding:0;border:0;border-radius:0;background:none;line-height:inherit;font-size:inherit;color:inherit}button::after{border:0}button[disabled]{opacity:.4;color:inherit;background:inherit}.page{padding:32rpx 30rpx 48rpx}.eyebrow{font-size:19rpx;font-weight:600;letter-spacing:4rpx;color:#a46e50}.page-title{font-size:48rpx;font-weight:700;letter-spacing:1rpx;margin-top:8rpx}.subtitle{font-size:24rpx;color:#91877a;line-height:1.7;margin-top:10rpx}.row{display:flex;align-items:center}.between{justify-content:space-between}.gap{gap:16rpx}.muted{color:#928a80}.small{font-size:22rpx}.pill{display:inline-flex;align-items:center;padding:10rpx 18rpx;border-radius:30rpx;background:#efe8dd;font-size:22rpx;color:#786553}.pill.accent{color:#a5472e;background:#f8e7de}.pill.green{color:#4b7355;background:#e9f0e5}.section-title{font-size:32rpx;font-weight:600}.card{background:#fffdfa;border:1rpx solid #eee7dd;border-radius:24rpx;padding:26rpx;margin-top:22rpx}.primary{background:#ba4b2d;color:#fffaf2;border-radius:14rpx;padding:24rpx 28rpx;font-weight:600;text-align:center}.secondary{background:#f1e9de;color:#6d5745;border-radius:14rpx;padding:20rpx 24rpx;text-align:center}.text-button{color:#ad4e32;font-size:24rpx;padding:12rpx 0}.divider{height:1rpx;background:#eee8df;margin:24rpx 0}.empty{padding:90rpx 28rpx;text-align:center}.empty-mark{font-size:72rpx;color:#d0bca1;font-weight:200}.empty-title{font-size:30rpx;font-weight:600;margin:24rpx 0 14rpx}.empty-copy{font-size:25rpx;color:#948a7e;line-height:1.8;margin-bottom:32rpx}.notice{background:#f1eadd;color:#94724f;border-radius:12rpx;font-size:21rpx;line-height:1.7;padding:16rpx 20rpx}.overlay{position:fixed;inset:0;background:rgba(25,22,18,.5);z-index:50;display:flex;align-items:flex-end}.sheet{width:100%;max-height:86vh;border-radius:32rpx 32rpx 0 0;background:#fffcf7;padding:30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));box-shadow:0 -12rpx 80rpx #17120c20}.sheet-scroll{max-height:44vh}.close{font-size:40rpx;color:#8c8176;padding:8rpx 12rpx;line-height:1}.field-label{font-size:25rpx;font-weight:600;margin:26rpx 0 14rpx}.input{width:100%;background:#f5f0e8;border:1rpx solid #e9dfd2;border-radius:12rpx;padding:22rpx;font-size:28rpx;height:88rpx}.textarea{height:150rpx;line-height:1.6}.stepper{display:flex;align-items:center;gap:22rpx}.step-button{height:48rpx;width:48rpx;background:#ba4b2d;color:#fff;border-radius:50%;font-size:34rpx;line-height:44rpx;text-align:center}.step-button.minus{background:#f4ebe0;color:#9b7053}.amount{font-size:34rpx;font-weight:700;color:#b44d31;font-variant-numeric:tabular-nums}.currency{font-size:22rpx;margin-right:3rpx}.chip{border:1rpx solid #e6ded2;padding:16rpx 24rpx;border-radius:12rpx;font-size:25rpx;background:#fffdfa}.chip.selected{background:#fbebe2;color:#b44b2d;border-color:#d9a18b}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.danger{color:#b74734}.footer-note{text-align:center;font-size:20rpx;letter-spacing:2rpx;color:#b4a894;margin-top:36rpx}
